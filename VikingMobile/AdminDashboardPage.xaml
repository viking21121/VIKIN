<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VikingMobile.AdminDashboardPage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <RefreshView
        x:Name="ContenidoRefresh"
        RefreshColor="White"
        Refreshing="ContenidoRefresh_Refreshing">

        <ScrollView>

            <VerticalStackLayout
                Padding="24,55,24,35"
                Spacing="0">

                <Button Text="← Inicio" TextColor="#AAAAAA" BackgroundColor="Transparent"
                        HorizontalOptions="Start" Padding="0" Clicked="Inicio_Tapped" />

                <!-- ENCABEZADO -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Image
                        x:Name="LogoEstablecimientoImagen"
                        Grid.Column="0"
                        HeightRequest="34"
                        WidthRequest="34"
                        Aspect="AspectFit"
                        Margin="0,0,10,0"
                        IsVisible="False" />

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label
                            x:Name="MarcaTextoLabel"
                            Text="VIKING"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CharacterSpacing="3" />

                        <Label
                            x:Name="EstablecimientoLabel"
                            Text="🏢 Mi establecimiento"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="Salir"
                        TextColor="#F87171"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarSesionLabel_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>

                <!-- MÉTRICAS -->
                <Grid
                    Margin="0,22,0,0"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="12">

                    <Border
                        Grid.Row="0" Grid.Column="0"
                        Padding="16"
                        BackgroundColor="#171717"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👥 ALUMNOS" TextColor="#999999" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label x:Name="TotalAlumnosLabel" Text="0" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="0" Grid.Column="1"
                        Padding="16"
                        BackgroundColor="#171717"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🟢 ACTIVOS" TextColor="#999999" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label x:Name="ActivosLabel" Text="0" TextColor="#4ADE80" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="1" Grid.Column="0"
                        x:Name="PorVencerCardBorder"
                        Padding="16"
                        BackgroundColor="#171717"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚠️ POR VENCER" TextColor="#999999" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label x:Name="PorVencerLabel" Text="0" TextColor="#FBBF24" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PorVencerCard_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                        Grid.Row="1" Grid.Column="1"
                        x:Name="MorososCardBorder"
                        Padding="16"
                        BackgroundColor="#171717"
                        Stroke="#444444"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🔴 MOROSOS" TextColor="#999999" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label x:Name="MorososLabel" Text="0" TextColor="#F87171" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MorososCard_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>


                </Grid>

                <!-- RECAUDADO -->
                <Border
                    Margin="0,12,0,0"
                    Padding="18,16"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="💰 RECAUDADO ESTE MES"
                            TextColor="#999999"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="RecaudadoLabel"
                            Grid.Column="1"
                            Text="$0"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </Grid>

                </Border>

                <!-- ACCESOS RÁPIDOS -->
                <Label
                    Text="ACCESOS"
                    TextColor="#999999"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    Margin="4,28,0,10" />

                <Border
                    Padding="4"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout>

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="📷" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Registrar asistencia (Scanner)" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AsistenciasGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="👥" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Alumnos" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlumnosGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="💵" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Pagos" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="Selecciona un alumno" TextColor="#666666" FontSize="12" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlumnosGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="🧾" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Recibos" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="Por alumno" TextColor="#666666" FontSize="12" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlumnosGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto,Auto" Padding="14,14">
                            <Label Text="📤" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Pagos por aprobar" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border
                                Grid.Column="2"
                                x:Name="PagosPendientesBadge"
                                Padding="9,3"
                                Margin="0,0,8,0"
                                BackgroundColor="#DC2626"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                IsVisible="False"
                                VerticalOptions="Center">
                                <Label x:Name="PagosPendientesBadgeLabel" Text="0" TextColor="White" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Label Grid.Column="3" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PagosPendientesGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Métodos de pago" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="MetodosPagoGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="🖼️" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Logo del establecimiento" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="LogoGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="14,0" />

                        <Grid ColumnDefinitions="50,*,Auto" Padding="14,14">
                            <Label Text="📊" FontSize="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Reportes" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#AAAAAA" FontSize="24" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ReportesGrid_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>
