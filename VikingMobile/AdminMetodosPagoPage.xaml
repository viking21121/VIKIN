<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VikingMobile.AdminMetodosPagoPage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="24,55,24,35" Spacing="0">

            <Grid ColumnDefinitions="Auto,*">
                <Label
                    Text="‹"
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VolverLabel_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    Grid.Column="1"
                    Text="⚙️ Métodos de pago"
                    TextColor="White"
                    FontSize="22"
                    FontAttributes="Bold"
                    Margin="10,0,0,0"
                    VerticalOptions="Center" />
            </Grid>

            <Label
                Text="Activa cada método que aceptas y escribe los datos para que el alumno pueda pagarte (banco, teléfono, cédula, correo, usuario, etc.)."
                TextColor="#888888"
                FontSize="12"
                Margin="0,10,0,20" />

            <!-- Un bloque por método. Todos siguen el mismo patrón. -->
            <VerticalStackLayout x:Name="MetodosStack" Spacing="14" />

            <Label
                x:Name="EstadoLabel"
                Text=""
                TextColor="#F87171"
                FontSize="13"
                Margin="0,16,0,0"
                IsVisible="False" />

            <Button
                x:Name="GuardarButton"
                Text="GUARDAR"
                TextColor="Black"
                BackgroundColor="White"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="55"
                Margin="0,20,0,0"
                Clicked="GuardarButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
