<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VikingMobile.AdminLogoPage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="24,55,24,35" Spacing="0">

        <Grid ColumnDefinitions="Auto,*">
            <Label
                Text="‹"
                TextColor="White"
                FontSize="30"
                FontAttributes="Bold"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="VolverLabel_Tapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                Grid.Column="1"
                Text="🖼️ Logo del establecimiento"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold"
                Margin="10,0,0,0"
                VerticalOptions="Center" />
        </Grid>

        <Label
            Text="Se muestra en la pantalla de inicio y en Mi Cuenta en vez del logo de Viking."
            TextColor="#888888"
            FontSize="12"
            Margin="0,10,0,24" />

        <Border
            Padding="10"
            HeightRequest="180"
            BackgroundColor="#171717"
            Stroke="#444444"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14"
            HorizontalOptions="Center">

            <Grid WidthRequest="180">
                <Image x:Name="PreviewImagen" Aspect="AspectFit" IsVisible="False" />
                <Label
                    x:Name="SinLogoLabel"
                    Text="Sin logo todavía"
                    TextColor="#666666"
                    FontSize="13"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

        </Border>

        <Button
            x:Name="ElegirButton"
            Text="🖼️ ELEGIR IMAGEN"
            TextColor="White"
            BackgroundColor="#171717"
            BorderColor="#444444"
            BorderWidth="1"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="52"
            Margin="0,24,0,0"
            Clicked="ElegirButton_Clicked" />

        <Label
            x:Name="ErrorLabel"
            Text=""
            TextColor="#F87171"
            FontSize="13"
            Margin="0,14,0,0"
            IsVisible="False" />

        <Button
            x:Name="GuardarButton"
            Text="GUARDAR"
            TextColor="Black"
            BackgroundColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="55"
            Margin="0,16,0,0"
            IsEnabled="False"
            Clicked="GuardarButton_Clicked" />

    </VerticalStackLayout>

</ContentPage>
