<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cliente="clr-namespace:VikingMobile.Application.Cliente"
    x:Class="VikingMobile.MiCuentaPage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <RefreshView
        x:Name="ContenidoRefresh"
        RefreshColor="White"
        Refreshing="ContenidoRefresh_Refreshing">

        <ScrollView>

            <VerticalStackLayout
                Padding="24,55,24,35"
                Spacing="0">
                <Button Text="← Inicio" TextColor="#AAAAAA" BackgroundColor="Transparent"
                        HorizontalOptions="Start" Padding="0" Clicked="Inicio_Tapped" />

                <!-- ENCABEZADO -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Image
                        x:Name="LogoEstablecimientoImagen"
                        Grid.Column="0"
                        HeightRequest="34"
                        WidthRequest="34"
                        Aspect="AspectFit"
                        Margin="0,0,10,0"
                        IsVisible="False" />

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label
                            x:Name="MarcaTextoLabel"
                            Text="VIKING"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CharacterSpacing="3" />

                        <Label
                            x:Name="SaludoLabel"
                            Text="Hola 👋"
                            TextColor="White"
                            FontSize="24"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="Salir"
                        TextColor="#F87171"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarSesionLabel_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>

                <Label
                    x:Name="OfflineLabel"
                    Text="🟠 Mostrando la última información guardada (sin conexión)"
                    TextColor="#FBBF24"
                    FontSize="12"
                    Margin="0,10,0,0"
                    IsVisible="False" />

                <!-- AVISO DE VENCIMIENTO -->
                <Border
                    x:Name="VencimientoBanner"
                    Margin="0,14,0,0"
                    Padding="16,14"
                    BackgroundColor="#3A2A0A"
                    Stroke="#B45309"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    IsVisible="False">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            x:Name="VencimientoBannerLabel"
                            Text="⚠️ Tu plan vence pronto"
                            TextColor="#FBBF24"
                            FontSize="13"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap" />

                        <Label
                            Grid.Column="1"
                            Text="Pagar ›"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            Margin="10,0,0,0" />
                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VencimientoBanner_Tapped" />
                    </Border.GestureRecognizers>

                </Border>

                <!-- CARNÉ DIGITAL DEL ALUMNO (VIKING PASS) -->
                <Border
                    Margin="0,18,0,0"
                    Padding="18"
                    BackgroundColor="#121212"
                    Stroke="#333333"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                        <!-- Foto circular del alumno -->
                        <Border
                            WidthRequest="80"
                            HeightRequest="80"
                            Stroke="#4ADE80"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 40"
                            BackgroundColor="#1F2937"
                            VerticalOptions="Center">

                            <Grid>
                                <Label
                                    x:Name="FotoPlaceholderLabel"
                                    Text="👤"
                                    FontSize="34"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Image
                                    x:Name="FotoAlumnoImage"
                                    Aspect="AspectFill"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    IsVisible="False" />
                            </Grid>

                        </Border>

                        <!-- Datos del alumno y botones de acción -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                            <Label
                                x:Name="CarnetNombreLabel"
                                Text="Nombre Alumno"
                                TextColor="White"
                                FontSize="17"
                                FontAttributes="Bold" />

                            <Label
                                x:Name="CarnetCodigoLabel"
                                Text="ID: A000"
                                TextColor="#9CA3AF"
                                FontSize="13" />

                            <Label
                                x:Name="CarnetCedulaLabel"
                                Text="Cédula: —"
                                TextColor="#D1D5DB"
                                FontSize="12" />

                            <Label
                                x:Name="CarnetTelefonoLabel"
                                Text="Teléfono: —"
                                TextColor="#D1D5DB"
                                FontSize="12" />

                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                <Button
                                    x:Name="TomarFotoButton"
                                    Text="📷 Foto"
                                    FontSize="11"
                                    TextColor="Black"
                                    BackgroundColor="#4ADE80"
                                    FontAttributes="Bold"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Clicked="TomarFotoButton_Clicked" />

                                <Button
                                    x:Name="EditarDatosButton"
                                    Text="✏️ Datos"
                                    FontSize="11"
                                    TextColor="White"
                                    BackgroundColor="#262626"
                                    BorderColor="#555555"
                                    BorderWidth="1"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Clicked="EditarDatosButton_Clicked" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- TARJETA DE PLAN -->
                <Border
                    Margin="0,22,0,0"
                    Padding="20"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                x:Name="ActividadLabel"
                                Text="🏊 Natación"
                                TextColor="#999999"
                                FontSize="13"
                                FontAttributes="Bold" />

                            <Border
                                Grid.Column="1"
                                x:Name="EstadoBadge"
                                Padding="10,4"
                                BackgroundColor="#16803A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">
                                <Label
                                    x:Name="EstadoBadgeLabel"
                                    Text="ACTIVO"
                                    TextColor="White"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1" />
                            </Border>
                        </Grid>

                        <Label
                            x:Name="PlanLabel"
                            Text="Plan: Mensual"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#333333"
                            Margin="0,4,0,4" />

                        <Grid ColumnDefinitions="*,*">

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="VENCIMIENTO"
                                    TextColor="#888888"
                                    FontSize="11"
                                    FontAttributes="Bold" />
                                <Label
                                    x:Name="VencimientoLabel"
                                    Text="—"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">
                                <Label
                                    Text="CLASES RESTANTES"
                                    TextColor="#888888"
                                    FontSize="11"
                                    FontAttributes="Bold" />
                                <Label
                                    x:Name="ClasesLabel"
                                    Text="—"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold" />
                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- SALDO -->
                <Border
                    Margin="0,14,0,0"
                    Padding="20,16"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="💰 SALDO PENDIENTE"
                                TextColor="#999999"
                                FontSize="12"
                                FontAttributes="Bold"
                                CharacterSpacing="1" />
                        </VerticalStackLayout>

                        <Label
                            x:Name="SaldoLabel"
                            Grid.Column="1"
                            Text="$0"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </Grid>

                </Border>

                <Button
                    x:Name="PagarButton"
                    Text="💳 PAGAR"
                    TextColor="Black"
                    BackgroundColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    Margin="0,12,0,0"
                    Clicked="PagarButton_Clicked" />

                <!-- PAGOS PENDIENTES -->
                <Label
                    Text="💳 PAGOS PENDIENTES"
                    TextColor="#999999"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    Margin="4,26,0,8" />

                <CollectionView
                    x:Name="PagosPendientesCollection"
                    SelectionMode="None"
                    EmptyView="No tienes pagos pendientes">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="cliente:SolicitudPagoClienteResumen">
                            <Border
                                Margin="0,0,0,10"
                                Padding="16,14"
                                BackgroundColor="#171717"
                                Stroke="#444444"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">

                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Concepto}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding FechaCreacion}" TextColor="#888888" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding MontoUsd, StringFormat='${0}'}"
                                            TextColor="#4ADE80"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Border
                                        Padding="10,4"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{Binding Estado, Converter={StaticResource SolicitudEstadoColorConverter}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20">
                                        <Label
                                            Text="{Binding Estado, Converter={StaticResource SolicitudEstadoTextoConverter}}"
                                            TextColor="White"
                                            FontSize="11"
                                            FontAttributes="Bold" />
                                    </Border>

                                    <Label
                                        Text="{Binding ComentarioAdmin}"
                                        TextColor="#F87171"
                                        FontSize="12"
                                        IsVisible="{Binding Estado, Converter={StaticResource EsRechazadoConverter}}" />

                                    <Button
                                        Text="📤 SUBIR COMPROBANTE"
                                        TextColor="Black"
                                        BackgroundColor="#60A5FA"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="12"
                                        HeightRequest="42"
                                        IsVisible="{Binding Estado, Converter={StaticResource PuedeSubirComprobanteConverter}}"
                                        Clicked="SubirComprobanteButton_Clicked" />

                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- RECIBOS -->
                <Label
                    Text="🧾 MIS RECIBOS"
                    TextColor="#999999"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    Margin="4,26,0,8" />

                <Border
                    Padding="4"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout>
                        <CollectionView
                            x:Name="RecibosCollection"
                            SelectionMode="None"
                            EmptyView="Sin recibos registrados">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="cliente:ReciboResumen">
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto"
                                        Padding="14,12"
                                        ColumnSpacing="8">

                                        <VerticalStackLayout Spacing="1">
                                            <Label
                                                Text="{Binding Folio}"
                                                TextColor="White"
                                                FontSize="14"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding Fecha}"
                                                TextColor="#888888"
                                                FontSize="12" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Monto, StringFormat='${0}'}"
                                            TextColor="#4ADE80"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />

                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="VER" FontSize="11" Padding="10,4" Clicked="VerRecibo_Clicked" />
                                            <Button Text="DESCARGAR" FontSize="11" Padding="10,4" Clicked="DescargarRecibo_Clicked" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                </Border>

                <!-- ASISTENCIAS -->
                <Label
                    Text="📅 MIS ASISTENCIAS"
                    TextColor="#999999"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    Margin="4,26,0,8" />

                <Border
                    Padding="4"
                    BackgroundColor="#171717"
                    Stroke="#444444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout>
                        <CollectionView
                            x:Name="AsistenciasCollection"
                            SelectionMode="None"
                            EmptyView="Sin historial de asistencias">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="cliente:AsistenciaMensual">
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Padding="14,12">

                                        <Label
                                            Text="{Binding Mes}"
                                            TextColor="White"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Cantidad, StringFormat='{0} clases'}"
                                            TextColor="#888888"
                                            FontSize="13"
                                            VerticalOptions="Center" />

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>
