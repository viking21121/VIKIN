<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VikingMobile.ClienteLoginPage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,35"
            Spacing="0">

            <Button Text="← Atrás" TextColor="#AAAAAA" BackgroundColor="Transparent" HorizontalOptions="Start" Padding="0" Clicked="Atras_Tapped" />

            <Label
                Text="VIKING"
                TextColor="White"
                FontSize="32"
                FontAttributes="Bold"
                CharacterSpacing="5"
                HorizontalTextAlignment="Center" />

            <Label
                Text="MI CUENTA"
                TextColor="#AAAAAA"
                FontSize="13"
                FontAttributes="Bold"
                CharacterSpacing="5"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,45" />

            <Label
                Text="CÓDIGO DEL ALUMNO"
                TextColor="#999999"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Margin="0,0,0,8" />

            <Border
                Padding="18,4"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <Grid ColumnDefinitions="*,Auto">
                    <Entry
                        x:Name="CodigoEntry"
                        Placeholder="A001"
                        PlaceholderColor="#666666"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        Keyboard="Text"
                        ReturnType="Next" />

                    <Label
                        Grid.Column="1"
                        Text="📷"
                        FontSize="22"
                        VerticalOptions="Center"
                        Margin="10,0,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EscanearQrLabel_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

            </Border>

            <Label
                Text="PIN"
                TextColor="#999999"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Margin="0,20,0,8" />

            <Border
                Padding="18,4"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <Entry
                    x:Name="PinEntry"
                    Placeholder="••••"
                    PlaceholderColor="#666666"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    IsPassword="True"
                    Keyboard="Numeric"
                    ReturnType="Go"
                    Completed="ContinuarButton_Clicked" />

            </Border>

            <Label
                x:Name="EstadoLabel"
                Text=""
                TextColor="#F87171"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Margin="0,16,0,0"
                IsVisible="False" />

            <Button
                x:Name="ContinuarButton"
                Text="CONTINUAR"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="Black"
                BackgroundColor="White"
                CornerRadius="16"
                HeightRequest="55"
                Margin="0,26,0,0"
                Clicked="ContinuarButton_Clicked" />

            <Button
                Text="CONFIGURAR MI PIN"
                TextColor="#3B82F6"
                BackgroundColor="Transparent"
                FontAttributes="Bold"
                Margin="0,8,0,0"
                Clicked="CrearPin_Tapped" />

            <Button
                Text="¿OLVIDASTE TU PIN?"
                TextColor="#AAAAAA"
                BackgroundColor="Transparent"
                FontSize="12"
                Clicked="RecuperarPin_Tapped" />

            <Label
                Text="Tu código pertenece a tu establecimiento"
                TextColor="#777777"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
