<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admin="clr-namespace:VikingMobile.Application.Admin"
    x:Class="VikingMobile.AdminAlumnoDetallePage"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="24,55,24,35" Spacing="0">

            <!-- ENCABEZADO -->
            <Grid ColumnDefinitions="Auto,*">
                <Label
                    Text="‹"
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VolverLabel_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    Grid.Column="1"
                    Text="Ficha del Alumno"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    Margin="10,0,0,0"
                    VerticalOptions="Center" />
            </Grid>

            <!-- PERFIL DEL ALUMNO (FOTO + DATOS + ACCIONES) -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                BackgroundColor="#171717"
                Stroke="#333333"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <!-- FOTO CIRCULAR / AVATAR -->
                        <Border
                            x:Name="FotoPerfilBorder"
                            WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="RoundRectangle 40"
                            Stroke="#16803A"
                            StrokeThickness="3"
                            BackgroundColor="#242424"
                            VerticalOptions="Center">
                            <Grid>
                                <Image
                                    x:Name="FotoPerfilImage"
                                    Aspect="AspectFill"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    IsVisible="False" />
                                <Label
                                    x:Name="InicialesPerfilLabel"
                                    Text="??"
                                    TextColor="#DDDDDD"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- DATOS PRINCIPALES -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label x:Name="NombreLabel" Text="Alumno" TextColor="White" FontSize="19" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="CodigoLabel" Text="A000" TextColor="#EAB308" FontSize="13" FontAttributes="Bold" />
                                <Label Text="·" TextColor="#555555" FontSize="13" />
                                <Label x:Name="CedulaLabel" Text="Sin Cédula" TextColor="#AAAAAA" FontSize="13" />
                            </HorizontalStackLayout>
                            <Label x:Name="TelefonoLabel" Text="Sin Teléfono" TextColor="#888888" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- BOTONES DE ACCIÓN RÁPIDA -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button
                            x:Name="TomarFotoButton"
                            Text="📷 Foto"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#2A2A2A"
                            CornerRadius="10"
                            HeightRequest="38"
                            Padding="0"
                            Clicked="TomarFotoButton_Clicked" />

                        <Button
                            x:Name="EditarDatosButton"
                            Text="✏️ Datos"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#2A2A2A"
                            CornerRadius="10"
                            HeightRequest="38"
                            Padding="0"
                            Clicked="EditarDatosButton_Clicked" />

                        <Button
                            x:Name="WhatsAppButton"
                            Text="💬 WhatsApp"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="Black"
                            BackgroundColor="#22C55E"
                            CornerRadius="10"
                            HeightRequest="38"
                            Padding="0"
                            Clicked="WhatsAppButton_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- TARJETA DE PLAN -->
            <Border
                Margin="0,16,0,0"
                Padding="18"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="PlanLabel" Text="Plan" TextColor="White" FontSize="17" FontAttributes="Bold" />

                        <Border
                            Grid.Column="1"
                            x:Name="EstadoBadge"
                            Padding="10,4"
                            BackgroundColor="#16803A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                            <Label x:Name="EstadoBadgeLabel" Text="ACTIVO" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="0,2,0,2" />

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="VENCIMIENTO" TextColor="#888888" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="VencimientoLabel" Text="—" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="SALDO PENDIENTE" TextColor="#888888" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="SaldoLabel" Text="$0" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- BOTÓN REGISTRAR PAGO -->
            <Button
                x:Name="MostrarFormularioButton"
                Text="💵 REGISTRAR PAGO"
                TextColor="Black"
                BackgroundColor="White"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52"
                Margin="0,16,0,0"
                Clicked="MostrarFormularioButton_Clicked" />

            <!-- FORMULARIO DE PAGO (oculto por defecto) -->
            <Border
                x:Name="FormularioBorder"
                Margin="0,14,0,0"
                Padding="18"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                IsVisible="False">

                <VerticalStackLayout Spacing="12">

                    <Label Text="MONTO EN USD" TextColor="#999999" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="MontoEntry" Placeholder="0.00" Keyboard="Numeric" TextColor="White" PlaceholderColor="#666666" />

                    <Label Text="TASA BCV" TextColor="#999999" FontSize="11" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="TasaEntry" Placeholder="0.00" Keyboard="Numeric" TextColor="White" PlaceholderColor="#666666" />
                        <Button
                            Grid.Column="1"
                            x:Name="ActualizarTasaButton"
                            Text="🔄"
                            WidthRequest="46"
                            HeightRequest="46"
                            Padding="0"
                            BackgroundColor="#2A2A2A"
                            TextColor="White"
                            Clicked="ActualizarTasaButton_Clicked" />
                    </Grid>

                    <Picker x:Name="MetodoPicker" TextColor="White" TitleColor="#666666">
                        <Picker.Items>
                            <x:String>Efectivo $</x:String>
                            <x:String>Efectivo bs</x:String>
                            <x:String>Pagomovil</x:String>
                            <x:String>Transferencia</x:String>
                            <x:String>Zelle</x:String>
                            <x:String>Binance Pay</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="REFERENCIA (OPCIONAL)" TextColor="#999999" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="ReferenciaEntry" Placeholder="Número de referencia" TextColor="White" PlaceholderColor="#666666" />

                    <Label
                        x:Name="FormularioErrorLabel"
                        Text=""
                        TextColor="#F87171"
                        FontSize="13"
                        IsVisible="False" />

                    <Button
                        x:Name="GuardarPagoButton"
                        Text="GUARDAR PAGO"
                        TextColor="Black"
                        BackgroundColor="#4ADE80"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        Clicked="GuardarPagoButton_Clicked" />

                </VerticalStackLayout>

            </Border>

            <!-- BOTÓN SOLICITAR PAGO AL ALUMNO -->
            <Button
                x:Name="MostrarSolicitudButton"
                Text="📤 SOLICITAR PAGO AL ALUMNO"
                TextColor="White"
                BackgroundColor="#171717"
                BorderColor="#444444"
                BorderWidth="1"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52"
                Margin="0,10,0,0"
                Clicked="MostrarSolicitudButton_Clicked" />

            <!-- FORMULARIO DE SOLICITUD DE PAGO (oculto por defecto) -->
            <Border
                x:Name="SolicitudBorder"
                Margin="0,14,0,0"
                Padding="18"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                IsVisible="False">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="El alumno verá esta solicitud en Mi Cuenta y podrá subir su comprobante de pago."
                        TextColor="#888888"
                        FontSize="12" />

                    <Label Text="MONTO EN USD" TextColor="#999999" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="SolicitudMontoEntry" Placeholder="0.00" Keyboard="Numeric" TextColor="White" PlaceholderColor="#666666" />

                    <Label Text="CONCEPTO" TextColor="#999999" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="SolicitudConceptoEntry" Placeholder="Mensualidad de septiembre" TextColor="White" PlaceholderColor="#666666" />

                    <Label
                        x:Name="SolicitudErrorLabel"
                        Text=""
                        TextColor="#F87171"
                        FontSize="13"
                        IsVisible="False" />

                    <Button
                        x:Name="EnviarSolicitudButton"
                        Text="ENVIAR SOLICITUD"
                        TextColor="Black"
                        BackgroundColor="#60A5FA"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        Clicked="EnviarSolicitudButton_Clicked" />

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE PAGOS -->
            <Label
                Text="🧾 HISTORIAL DE PAGOS"
                TextColor="#999999"
                FontSize="12"
                FontAttributes="Bold"
                Margin="4,26,0,8" />

            <Border
                Padding="4"
                BackgroundColor="#171717"
                Stroke="#444444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <CollectionView
                    x:Name="PagosCollection"
                    SelectionMode="None"
                    EmptyView="Sin pagos registrados">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="admin:PagoAdminResumen">
                            <Grid ColumnDefinitions="*,Auto" Padding="14,12">

                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Folio}" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding FechaPago, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#888888" FontSize="12" />
                                    <Label Text="{Binding MetodoPago}" TextColor="#888888" FontSize="11" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding MontoUsd, StringFormat='${0}'}"
                                    TextColor="#4ADE80"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Pago_Tapped" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
