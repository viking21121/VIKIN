<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>AsistenciaNatacion</RootNamespace>
		<AssemblyName>Viking</AssemblyName>
		<Product>VIKING</Product>
		<Description>Plataforma de gestión para academias, piscinas, CrossFit, entrenamiento funcional y gimnasios.</Description>
		<Copyright>© 2026 — Todos los derechos reservados.</Copyright>
		<!-- Única fuente de la versión: AssemblyVersion, FileVersion e InformationalVersion se derivan de aquí.
		     El flujo de publicación la reemplaza con el número del tag (vX.Y.Z). -->
		<Version>1.0.3</Version>
			<ApplicationIcon>viking_logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
    <Content Include="viking_logo.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="VikingUpdater\VikingUpdater.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="CopyVikingUpdaterAfterPublish" AfterTargets="Publish">
		<Copy SourceFiles="$(MSBuildProjectDirectory)\VikingUpdater\bin\$(Configuration)\net8.0-windows\win-x64\VikingUpdater.exe" DestinationFiles="$(PublishDir)VikingUpdater.exe" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\VikingUpdater\bin\$(Configuration)\net8.0-windows\win-x64\VikingUpdater.dll" DestinationFiles="$(PublishDir)VikingUpdater.dll" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\VikingUpdater\bin\$(Configuration)\net8.0-windows\win-x64\VikingUpdater.runtimeconfig.json" DestinationFiles="$(PublishDir)VikingUpdater.runtimeconfig.json" SkipUnchangedFiles="true" />
	</Target>
	
	<ItemGroup>
	  <Compile Remove="proyecto2\**" />
	  <Compile Remove="VIKINGO editable 1.1\**" />
	  <EmbeddedResource Remove="proyecto2\**" />
	  <EmbeddedResource Remove="VIKINGO editable 1.1\**" />
	  <None Remove="proyecto2\**" />
	  <None Remove="VIKINGO editable 1.1\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
		<!-- QRCoder: genera las imágenes de código QR. Sin dependencias externas,
         una vez descargado (dotnet restore) funciona sin internet para siempre. -->
		<PackageReference Include="QRCoder" Version="1.5.1" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="VikingUpdater\**" />
		<EmbeddedResource Remove="VikingUpdater\**" />
		<None Remove="VikingUpdater\**" />
		<Compile Remove="Viking.Tests\**" />
		<EmbeddedResource Remove="Viking.Tests\**" />
		<None Remove="Viking.Tests\**" />
	</ItemGroup>
</Project>